{
  "manifest_version": 3,
  "name": "Collaborate-Bench for LinkedIn",
  "short_name": "Collaborate-Bench",
  "version": "1.0.0",
  "description": "Side panel for US IT bench sales: save LinkedIn profiles as leads, log outreach, set reminders, and turn job posts into requirements with bench matches.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open Collaborate-Bench", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "scripting"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:5173/*",
    "http://localhost:5174/*",
    "http://localhost:5080/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
